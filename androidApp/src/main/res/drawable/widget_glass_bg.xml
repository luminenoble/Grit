<?xml version="1.0" encoding="utf-8"?><!--
    Liquid glass widget pane: translucent white gradient (lighter at the top,
    like light catching the glass) with a specular hairline edge. The launcher
    wallpaper shows through, which is what sells the glass effect.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:startColor="#E8FFFFFF"
        android:endColor="#C4F2F3F7" />
    <stroke
        android:width="1dp"
        android:color="#99FFFFFF" />
</shape>
